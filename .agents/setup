#!/usr/bin/env bash
# Prepares a fresh Amp orb for this repository. Idempotent: safe to rerun on a
# stale snapshot. Installs the plugin's runtime (bash, jq, fzf, herdr CLI) and
# a linter for orb.sh. The amp CLI is part of the orb image.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() { printf '\n==> %s (%ss elapsed)\n' "$1" "$SECONDS"; }

# --- System packages ------------------------------------------------------
# jq parses context and JSON in orb.sh, fzf drives the orb picker popup, and
# the linter checks orb.sh.
step "system packages"
missing=()
for pkg in jq fzf shellcheck; do
  dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if [ "${#missing[@]}" -gt 0 ]; then
  export DEBIAN_FRONTEND=noninteractive
  sudo apt-get update -qq
  sudo apt-get install -y -qq "${missing[@]}"
else
  echo "jq, fzf and shellcheck already installed"
fi

# --- herdr CLI ------------------------------------------------------------
# The plugin's host program, pinned so every orb tests against the same
# version. herdr.dev/install.sh only installs the latest release, so download
# the release binary directly. ~/.local/bin is already on the orb's login PATH.
step "herdr CLI"
herdr_version=0.9.5
herdr_bin="$HOME/.local/bin/herdr"
if [ "$("$herdr_bin" --version 2>/dev/null)" = "herdr $herdr_version" ]; then
  echo "herdr $herdr_version already installed"
else
  case "$(uname -m)" in
    x86_64)
      herdr_target=linux-x86_64
      herdr_sha256=14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d
      ;;
    aarch64 | arm64)
      herdr_target=linux-aarch64
      herdr_sha256=17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c
      ;;
    *)
      echo "no pinned herdr binary for $(uname -m)" >&2
      exit 1
      ;;
  esac
  mkdir -p "$(dirname "$herdr_bin")"
  curl -fsSL --retry 3 -o "$herdr_bin.tmp" \
    "https://github.com/herdrdev/herdr/releases/download/v$herdr_version/herdr-$herdr_target"
  echo "$herdr_sha256  $herdr_bin.tmp" | sha256sum -c -
  chmod +x "$herdr_bin.tmp"
  mv "$herdr_bin.tmp" "$herdr_bin"
  "$herdr_bin" --version
fi

# --- Orb notes for agents -------------------------------------------------
# No herdr server runs in a fresh orb, and one started from the Amp CLI dies
# when the CLI restarts, so tell agents to run it as a supervised service.
step "agent notes"
agents_md="$HOME/.config/amp/AGENTS.md"
notes_marker="## herdr-amp-orbs orb"
if grep -Fqx "$notes_marker" "$agents_md" 2>/dev/null; then
  echo "already in $agents_md"
else
  mkdir -p "$(dirname "$agents_md")"
  cat >> "$agents_md" <<EOF

$notes_marker

- \`jq\`, \`fzf\`, \`shellcheck\`, and the \`herdr\` CLI are installed. Lint with \`shellcheck $repo_root/orb.sh\`.
- No herdr server runs by default. To exercise the plugin, start one with \`amp orb service start herdr --command 'herdr server'\`, then run \`herdr plugin link $repo_root\`.
EOF
  echo "appended to $agents_md"
fi

step "done"
